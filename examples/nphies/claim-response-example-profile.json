{
  "resourceType": "StructureDefinition",
  "id": "example-claim-response",
  "url": "http://example.org/fhir/StructureDefinition/example-claim-response",
  "name": "ExampleClaimResponse",
  "status": "draft",
  "description": "Hand-authored, illustrative demo profile for a claim response with rejection errors — used to demonstrate hl7fhirgen's `nphies check-claim` command. NOT an official NPHIES profile.",
  "type": "ClaimResponse",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/ClaimResponse",
  "derivation": "constraint",
  "snapshot": {
    "element": [
      { "id": "ClaimResponse", "path": "ClaimResponse", "min": 0, "max": "*" },

      { "id": "ClaimResponse.status", "path": "ClaimResponse.status", "min": 1, "max": "1",
        "type": [{ "code": "code" }], "fixedCode": "active" },
      { "id": "ClaimResponse.outcome", "path": "ClaimResponse.outcome", "min": 1, "max": "1",
        "type": [{ "code": "code" }] },

      { "id": "ClaimResponse.error", "path": "ClaimResponse.error", "short": "Processing errors",
        "min": 0, "max": "*", "type": [{ "code": "BackboneElement" }], "mustSupport": true },
      { "id": "ClaimResponse.error.itemSequence", "path": "ClaimResponse.error.itemSequence",
        "min": 0, "max": "1", "type": [{ "code": "positiveInt" }] },
      { "id": "ClaimResponse.error.code", "path": "ClaimResponse.error.code",
        "min": 1, "max": "1", "type": [{ "code": "CodeableConcept" }], "mustSupport": true }
    ]
  }
}
